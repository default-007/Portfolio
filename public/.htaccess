# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Hashed assets are immutable; the entry document must never be cached.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Every Header directive lives inside this guard. An unguarded one is not
# ignored on a host without mod_headers -- Apache rejects it as "Invalid
# command 'Header'" and returns 500 for every request under this directory.
# Verified against Apache 2.4.58: identical .htaccess, mod_headers off, HTTP
# 500; mod_headers on, HTTP 200 with the header set. Free cPanel hosts do not
# guarantee the module, so the site must degrade to "no custom headers", never
# to a blank 500.
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # The entry document must never be cached: its <script> tag points at a
  # hashed asset that a redeploy replaces. The mod_expires block above says
  # the same thing, but only where mod_expires exists.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
